<Window x:Class="CalculadoraWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calculadora"
        Height="520"
        Width="340"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E1E">

    <Window.Resources>

        <Style x:Key="BotonBase" TargetType="Button">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Height" Value="70"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="12"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#3E3E42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonOperador"
               TargetType="Button"
               BasedOn="{StaticResource BotonBase}">
            <Setter Property="Background" Value="#FF8C00"/>
        </Style>

        <Style x:Key="BotonIgual"
               TargetType="Button"
               BasedOn="{StaticResource BotonBase}">
            <Setter Property="Background" Value="#007ACC"/>
        </Style>

        <Style x:Key="BotonLimpiar"
               TargetType="Button"
               BasedOn="{StaticResource BotonBase}">
            <Setter Property="Background" Value="#C74634"/>
        </Style>

    </Window.Resources>

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                CornerRadius="15"
                Background="#252526"
                Padding="15">

            <TextBox x:Name="txtPantalla"
                     Background="Transparent"
                     Foreground="White"
                     FontSize="36"
                     BorderThickness="0"
                     TextAlignment="Right"
                     VerticalContentAlignment="Center"
                     IsReadOnly="True"/>
        </Border>

        <Grid Grid.Row="1" Margin="0,15,0,0">

            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button Content="7" Grid.Row="0" Grid.Column="0"
                    Style="{StaticResource BotonBase}" Click="Boton_Click"/>
            <Button Content="8" Grid.Row="0" Grid.Column="1"
                    Style="{StaticResource BotonBase}" Click="Boton_Click"/>
            <Button Content="9" Grid.Row="0" Grid.Column="2"
                    Style="{StaticResource BotonBase}" Click="Boton_Click"/>
            <Button Content="/" Grid.Row="0" Grid.Column="3"
                    Style="{StaticResource BotonOperador}" Click="Boton_Click"/>

            <Button Content="4" Grid.Row="1" Grid.Column="0"
                    Style="{StaticResource BotonBase}" Click="Boton_Click"/>
            <Button Content="5" Grid.Row="1" Grid.Column="1"
                    Style="{StaticResource BotonBase}" Click="Boton_Click"/>
            <Button Content="6" Grid.Row="1" Grid.Column="2"
                    Style="{StaticResource BotonBase}" Click="Boton_Click"/>
            <Button Content="*" Grid.Row="1" Grid.Column="3"
                    Style="{StaticResource BotonOperador}" Click="Boton_Click"/>

            <Button Content="1" Grid.Row="2" Grid.Column="0"
                    Style="{StaticResource BotonBase}" Click="Boton_Click"/>
            <Button Content="2" Grid.Row="2" Grid.Column="1"
                    Style="{StaticResource BotonBase}" Click="Boton_Click"/>
            <Button Content="3" Grid.Row="2" Grid.Column="2"
                    Style="{StaticResource BotonBase}" Click="Boton_Click"/>
            <Button Content="-" Grid.Row="2" Grid.Column="3"
                    Style="{StaticResource BotonOperador}" Click="Boton_Click"/>

            <Button Content="0" Grid.Row="3" Grid.Column="0"
                    Style="{StaticResource BotonBase}" Click="Boton_Click"/>
            <Button Content="C" Grid.Row="3" Grid.Column="1"
                    Style="{StaticResource BotonLimpiar}" Click="Limpiar_Click"/>
            <Button Content="=" Grid.Row="3" Grid.Column="2"
                    Style="{StaticResource BotonIgual}" Click="Igual_Click"/>
            <Button Content="+" Grid.Row="3" Grid.Column="3"
                    Style="{StaticResource BotonOperador}" Click="Boton_Click"/>

        </Grid>
    </Grid>
</Window>
